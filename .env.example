# Database (Neon PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-neon-host.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=your_username
SPRING_DATASOURCE_PASSWORD=your_password

# Ingestion config (optional overrides)
APP_INGESTION_COOLDOWN_MINUTES=60
APP_INGESTION_MAX_RETRIES=3
APP_INGESTION_BACKOFF_BASE_MS=2000
APP_INGESTION_TIMEOUT_SECONDS=30
APP_INGESTION_SOURCE_URL=https://jobicy.com/api/v2/remote-jobs?count=50
